# Conseguir gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alias que Google mantiene apuntando siempre al Flash vigente (evita tener que
# actualizar esto cada vez que retiran un modelo). Si prefieres fijar una versión
# exacta para que el comportamiento no cambie sin aviso, usa p. ej. "gemini-3-flash".
GEMINI_MODEL=gemini-flash-latest
