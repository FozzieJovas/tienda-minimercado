# Conseguir gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Elegido probando varios modelos con una factura manuscrita real (ver docs/plan):
# 3.8 Flash, Flash-Lite Latest, 3.1 Flash-Lite, 3.5 Flash y 3.6 Flash también leyeron
# bien la factura, pero 3.5 Flash-Lite quedó como default por tener el límite diario
# gratuito mucho más alto (500 RPD vs. ~20 RPD de los modelos "Flash" normales). Si
# Google lo retira, cambia este valor por otro modelo vigente (no hace falta tocar código).
GEMINI_MODEL=gemini-3.5-flash-lite
