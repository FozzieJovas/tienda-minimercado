# Conseguir gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alias de Google que apunta siempre a la versión Flash-Lite vigente. Se prefiere
# sobre "gemini-flash-latest" (el Flash "grande") porque tiene más disponibilidad en
# la capa gratuita -- el Flash grande devolvía 503 "high demand" con frecuencia en
# pruebas reales. Es algo menos preciso con letra manuscrita difícil, pero evita
# tener que actualizar esto cada vez que Google retira una versión.
GEMINI_MODEL=gemini-flash-lite-latest
